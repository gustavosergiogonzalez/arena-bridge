# ---- Arena Bridge: config base ----
PORT=4010
HOST=0.0.0.0

# API key propia del bridge (opcional, recomendado si lo exponés fuera de tu PC).
BRIDGE_KEY=

# ---- Secretos para backends.json (expansión ${VAR}) ----
# NIM_API_KEY=nvapi-tu-key-completa-aca
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=

# ---- MODO LEGACY (un solo cerebro, sin backends.json) ----
